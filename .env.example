# Environment Configuration Example
# Copie este arquivo para .env e preencha com seus valores

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=iot/wbe/index

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=wbe_user
DB_PASSWORD=wbe_password
DB_NAME=wbe_database

# Backend API
API_HOST=127.0.0.1
API_PORT=8000

# Frontend
FRONTEND_PORT=8501

# Logs
LOG_LEVEL=INFO
